{
  "name": "@time-report/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.node.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.node.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "db:generate": "node --env-file-if-exists=.env ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/db/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx scripts/db/seed.ts",
    "db:seed:test": "node --env-file-if-exists=.env --import tsx scripts/db/seed-test.ts",
    "db:reset:test": "node --env-file-if-exists=.env --import tsx scripts/db/reset-test.ts",
    "db:migrate:sqlite": "node --env-file-if-exists=.env --import tsx scripts/db/migrate-sqlite-to-postgres.ts",
    "db:bootstrap": "npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "bcryptjs": "^3.0.2",
    "better-auth": "1.7.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.9.0",
    "postgres": "^3.4.7",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.0.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.0"
  }
}
