{
  "name": "time-report",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r --if-present run typecheck",
    "format:check": "pnpm -r --if-present run format:check",
    "db:generate": "pnpm --filter @time-report/api run db:generate",
    "db:migrate": "pnpm --filter @time-report/api run db:migrate",
    "db:seed": "pnpm --filter @time-report/api run db:seed",
    "db:bootstrap": "pnpm --filter @time-report/api run db:bootstrap"
  }
}
